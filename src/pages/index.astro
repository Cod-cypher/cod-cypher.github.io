---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
    title="Waqar | Full Stack AI Developer - Chatbots & Agentic Systems" 
    description="Full Stack AI Developer specializing in large-scale applications, intelligent chatbots, and agentic AI systems. Expert in LLMs, RAG, LangChain, Python, and modern web technologies."
>
    <!-- Hero Section -->
    <main class="hero">
        <div class="hero-bg-elements">
            <div class="bg-glow-blob"></div>

            <!-- Code Icon -->
            <svg class="bg-icon icon-code" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            <!-- Layers Icon -->
            <svg class="bg-icon icon-layers" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <!-- Cursor Icon -->
            <svg class="bg-icon icon-cursor" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
            </svg>
            <!-- Grid Icon -->
            <svg class="bg-icon icon-grid" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
            </svg>
            <!-- Pen/Edit Icon -->
            <svg class="bg-icon icon-pen" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
            <!-- Sparkle/Star Icon -->
            <svg class="bg-icon icon-sparkle" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            <!-- Terminal Icon -->
            <svg class="bg-icon icon-terminal" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <!-- Palette Icon -->
            <svg class="bg-icon icon-palette" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
        </div>

        <div class="hero-content">
            <h1 class="text-huge">
                I BUILD AI-POWERED<br>
                APPLICATIONS<br>
                THAT <span class="glow-word">SCALE.</span>
            </h1>
            <p class="hero-sub">Full Stack AI Developer specializing in chatbots, agentic systems, and large-scale intelligent applications.</p>
        </div>

        <div class="scroll-down">
            <svg width="24" height="24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
        </div>
    </main>

    <!-- Work Section -->
    <section id="work" class="section">
        <div class="section-header">
            <h2 class="section-title">Selected Work.</h2>
        </div>
        <div class="text-center py-20" style="color: var(--text-dim)">
            <p>Projects coming soon...</p>
        </div>
    </section>

    <!-- Blog Section -->
    <section id="blog" class="section">
        <div class="section-header">
            <h2 class="section-title">Latest Thoughts.</h2>
        </div>
        <div class="space-y-8">
            <a href="/how-i-built-this-website-in-30-minutes-using-gemini" class="blog-item">
                <span class="blog-date">Dec 09</span>
                <div>
                    <h3 class="blog-title">How I Built This Website in 30 Minutes Using Gemini — And the Honest Tradeoff Every Developer Now Faces</h3>
                    <p class="blog-desc">A deep dive into AI-assisted development and the balance between productivity and long-term skill growth.</p>
                    <span class="read-more">Read Article ↗</span>
                </div>
            </a>
        </div>
    </section>
</BaseLayout>

<style>
    /* Hero Section */
    .hero {
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        position: relative;
        padding: 0 20px;
        overflow: hidden;
    }

    .hero-content {
        position: relative;
        z-index: 10;
    }

    .text-huge {
        font-size: clamp(2rem, 10vw, 5.5rem);
        font-weight: 700;
        font-family: 'Space Grotesk', sans-serif;
        line-height: 1.1;
        letter-spacing: -2px;
        color: var(--text-color);
    }

    .glow-word {
        color: var(--accent-color);
        text-shadow: 0 0 30px var(--accent-color);
    }

    .hero-sub {
        margin-top: 20px;
        font-size: 1.2rem;
        color: var(--text-dim);
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .scroll-down {
        position: absolute;
        bottom: 40px;
        animation: bounce 2s infinite;
        z-index: 10;
    }

    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-10px); }
        60% { transform: translateY(-5px); }
    }

    /* Hero Background Elements */
    .hero-bg-elements {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }

    .bg-glow-blob {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 60vw;
        height: 60vw;
        background: radial-gradient(circle, var(--accent-color) 0%, rgba(0,0,0,0) 70%);
        opacity: 0.15;
        animation: pulse 8s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { transform: translate(-50%, -50%) scale(1); }
        50% { transform: translate(-50%, -50%) scale(1.1); }
    }

    .bg-icon {
        position: absolute;
        width: 80px;
        height: 80px;
        stroke: var(--text-dim);
        opacity: 0.2;
        animation: float 20s infinite ease-in-out;
    }

    .icon-code { top: 15%; left: 10%; animation-delay: 0s; }
    .icon-layers { top: 25%; right: 15%; animation-delay: 2s; }
    .icon-cursor { top: 65%; left: 12%; animation-delay: 4s; }
    .icon-grid { bottom: 20%; right: 10%; animation-delay: 1s; }
    .icon-pen { top: 45%; left: 8%; animation-delay: 3s; }
    .icon-sparkle { top: 70%; right: 20%; animation-delay: 5s; }
    .icon-terminal { bottom: 30%; left: 18%; animation-delay: 6s; }
    .icon-palette { top: 35%; right: 12%; animation-delay: 2.5s; }

    @keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); opacity: 0.2; }
        50% { transform: translateY(-20px) rotate(5deg); opacity: 0.3; }
    }

    /* Sections */
    .section {
        padding: 80px 24px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 48px;
    }

    .section-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 700;
        color: var(--text-color);
    }

    /* Blog Item */
    .blog-item {
        display: flex;
        gap: 24px;
        padding: 24px 0;
        border-bottom: 1px solid var(--border-color);
        transition: all 0.3s;
        text-decoration: none;
    }

    .blog-item:hover {
        transform: translateX(10px);
    }

    .blog-date {
        color: var(--text-dim);
        font-size: 0.9rem;
        min-width: 80px;
    }

    .blog-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 12px;
        transition: color 0.3s;
    }

    .blog-item:hover .blog-title {
        color: var(--accent-color);
    }

    .blog-desc {
        color: var(--text-dim);
        margin-bottom: 12px;
        line-height: 1.6;
    }

    .read-more {
        color: var(--text-dim);
        font-size: 0.9rem;
        transition: color 0.3s;
    }

    .blog-item:hover .read-more {
        color: var(--accent-color);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .text-huge {
            font-size: clamp(1.75rem, 9vw, 2.5rem);
        }
        
        .hero-sub {
            font-size: 1rem;
            padding: 0 10px;
        }

        .bg-icon {
            display: none;
        }

        .bg-glow-blob {
            width: 80vw;
            height: 80vw;
        }

        .section {
            padding: 60px 16px;
        }

        .blog-item {
            flex-direction: column;
            gap: 10px;
        }
    }
</style>
