---
// Footer.astro - Reusable footer component
---

<footer>
    <p class="footer-label">Got a project?</p>
    <a href="mailto:hello@waqar-tech.com" class="footer-email">HELLO@WAQAR-TECH.COM</a>
    <div class="footer-social">
        <div class="social-links">
            <a href="https://www.linkedin.com/in/waqar-shabbir-022653230/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
        <span>&copy; {new Date().getFullYear()} Waqar.</span>
    </div>
</footer>

<style>
    footer {
        background-color: var(--surface-color);
        padding: 80px 24px;
        text-align: center;
        margin-top: 80px;
    }
    
    .footer-label {
        text-transform: uppercase;
        color: var(--text-dim);
        margin-bottom: 32px;
        font-size: 0.9rem;
        letter-spacing: 2px;
    }
    
    .footer-email {
        font-size: clamp(2rem, 5vw, 5rem);
        font-weight: 700;
        font-family: 'Space Grotesk', sans-serif;
        color: var(--text-color);
        transition: color 0.3s;
        text-decoration: none;
        display: inline-block;
    }
    
    .footer-email:hover {
        color: var(--accent-color);
    }
    
    .footer-social {
        margin-top: 60px;
        font-size: 0.9rem;
        color: var(--text-dim);
    }
    
    .social-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 16px;
    }
    
    .social-links a {
        color: var(--text-color);
        transition: color 0.3s;
        text-decoration: none;
    }
    
    .social-links a:hover {
        color: var(--accent-color);
    }
    
    @media (max-width: 768px) {
        footer {
            padding: 50px 16px;
        }
        
        .footer-email {
            font-size: clamp(1.5rem, 6vw, 2.5rem);
        }
    }
</style>
